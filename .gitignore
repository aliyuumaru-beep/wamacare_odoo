# ─── Database Dumps & Backups (never in Git) ───────────────────────────────
*.dump
*.dump.zip
*.sql
*.tar.gz
*.tar.bz2
backups/*.zip
backups/*.sql
backups/*.dump
backups/**/*.sql
backups/**/*.dump

# ─── Odoo Filestore (binary attachment store) ──────────────────────────────
filestore/
*/filestore/

# ─── Odoo Config (contains credentials) ────────────────────────────────────
odoo.conf
wamacare.conf
*.conf
!docs/**/*.conf.example

# ─── Secrets & Environment ──────────────────────────────────────────────────
.env
.env.*
*.secret
credentials.json

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ─── macOS ──────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ─── Editor & IDE ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Logs ───────────────────────────────────────────────────────────────────
logs/
*.log

# ─── Node (if any web tooling added later) ─────────────────────────────────
node_modules/

# ─── Odoo session files ─────────────────────────────────────────────────────
sessions/
.odoo/
