<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Case Form View ──────────────────────────────────── -->
    <record id="view_wamacare_case_form" model="ir.ui.view">
        <field name="name">wamacare.case.form</field>
        <field name="model">wamacare.case</field>
        <field name="arch" type="xml">
            <form string="Case">
                <header>
                    <button name="action_escalate" type="object"
                            string="Escalate" class="btn-warning"
                            invisible="state in ('escalated','referred','closed')"/>
                    <button name="action_refer" type="object"
                            string="Mark as Referred" class="btn-info"
                            invisible="state in ('referred','closed')"/>
                    <button name="action_close" type="object"
                            string="Close Case" class="btn-secondary"
                            invisible="state == 'closed'"/>
                    <button name="action_reopen" type="object"
                            string="Re-open"
                            invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,in_progress,escalated,referred,closed"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_add_note" type="object"
                                class="oe_stat_button" icon="fa-sticky-note">
                            <field name="note_count" widget="statinfo" string="Notes"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group col="2">
                        <field name="beneficiary_id"/>
                        <field name="case_type"/>
                        <field name="severity"/>
                        <field name="assigned_to"/>
                        <field name="programme_id"/>
                        <field name="date_opened"/>
                        <field name="date_closed" invisible="state != 'closed'"/>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description"
                                   placeholder="Describe the concern factually and objectively..."/>
                        </page>

                        <page string="Case Notes">
                            <field name="note_ids" mode="tree">
                                <tree editable="bottom"
                                      decoration-warning="note_type == 'escalation'"
                                      decoration-danger="note_type == 'referral'">
                                    <field name="date" readonly="1"/>
                                    <field name="author_id" readonly="1"/>
                                    <field name="note_type"/>
                                    <field name="note"/>
                                    <field name="attachment_ids" widget="many2many_tags"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Evidence">
                            <field name="evidence_description"
                                   placeholder="Describe evidence: documents, photos, witness statements..."/>
                        </page>

                        <page string="Referral"
                              invisible="state not in ('referred','closed')">
                            <group col="2">
                                <field name="referral_agency"/>
                                <field name="referral_date"/>
                                <field name="referral_notes" colspan="2"/>
                                <field name="referral_outcome" colspan="2"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Case List View ─────────────────────────────────── -->
    <record id="view_wamacare_case_list" model="ir.ui.view">
        <field name="name">wamacare.case.list</field>
        <field name="model">wamacare.case</field>
        <field name="arch" type="xml">
            <tree string="Cases"
                  decoration-danger="severity == 'critical'"
                  decoration-warning="severity == 'high'"
                  decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="beneficiary_id"/>
                <field name="case_type"/>
                <field name="severity"/>
                <field name="state"/>
                <field name="assigned_to"/>
                <field name="date_opened"/>
                <field name="note_count" string="Notes"/>
            </tree>
        </field>
    </record>

    <!-- ── Case Search View ───────────────────────────────── -->
    <record id="view_wamacare_case_search" model="ir.ui.view">
        <field name="name">wamacare.case.search</field>
        <field name="model">wamacare.case</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="beneficiary_id"/>
                <field name="assigned_to"/>
                <filter string="Open"         name="open"         domain="[('state','=','open')]"/>
                <filter string="Escalated"    name="escalated"    domain="[('state','=','escalated')]"/>
                <filter string="Critical"     name="critical"     domain="[('severity','=','critical')]"/>
                <filter string="Safeguarding" name="safeguarding" domain="[('case_type','=','safeguarding')]"/>
                <filter string="Closed"       name="closed"       domain="[('state','=','closed')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status"   name="by_state"    context="{'group_by': 'state'}"/>
                    <filter string="Type"     name="by_type"     context="{'group_by': 'case_type'}"/>
                    <filter string="Severity" name="by_severity" context="{'group_by': 'severity'}"/>
                    <filter string="Assigned" name="by_assigned" context="{'group_by': 'assigned_to'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Window Action ──────────────────────────────────── -->
    <record id="action_wamacare_case" model="ir.actions.act_window">
        <field name="name">Cases</field>
        <field name="res_model">wamacare.case</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wamacare_case_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No cases yet.</p>
            <p>Cases open automatically when a safeguarding flag is raised on a beneficiary record, or can be created manually.</p>
        </field>
    </record>
</odoo>
